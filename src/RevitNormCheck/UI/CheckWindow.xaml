<Window x:Class="RevitNormCheck.UI.CheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка норм" Width="640" Height="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Root"/>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Выгрузить двери в Excel" Padding="16,5" Margin="0,0,24,0" Click="ExportDoorsClick"/>
            <Button Content="Проверить" Padding="16,5" Click="RunClick" IsDefault="True"/>
            <Button Content="Закрыть" Padding="16,5" Margin="8,0,0,0" Click="CloseClick" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
