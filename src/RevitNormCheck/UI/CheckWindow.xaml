<Window x:Class="RevitNormCheck.UI.CheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка норм" Width="560" Height="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Папка с нормами" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NormsPathBox" IsReadOnly="True" Padding="4"/>
            <Button Grid.Column="1" Content="Выбрать..." Margin="8,0,0,0" Padding="12,4" Click="BrowseClick"/>
        </Grid>

        <GroupBox Grid.Row="2" Header="Что проверять">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChecksPanel" Margin="8"/>
            </ScrollViewer>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Выбрать все" Padding="10,3" Click="SelectAllClick"/>
            <Button Content="Снять все" Padding="10,3" Margin="8,0,0,0" Click="ClearAllClick"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Проверить" Padding="16,5" Click="RunClick" IsDefault="True"/>
            <Button Content="Закрыть" Padding="16,5" Margin="8,0,0,0" Click="CloseClick" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
